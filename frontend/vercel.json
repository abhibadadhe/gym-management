{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://187.127.173.151:8000/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "http://187.127.173.151:8000/media/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "http://187.127.173.151:8000/static/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
