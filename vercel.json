{
  "functions": {
    "api/proxy.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/proxy?path=$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "/api/proxy?media=$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "/api/proxy?static=$1"
    },
    {
      "source": "/((?!api/|media/|static/).*)",
      "destination": "/index.html"
    }
  ]
}
