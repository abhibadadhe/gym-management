# ==============================================================================
# MORYA FITNESS – PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# General
DJANGO_SECRET_KEY=your-super-secret-key-change-this-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost

# ==============================================================================
# OPTION 1: Real PostgreSQL Database (Recommended for VPS / Cloud)
# ==============================================================================
# Standard URL format: postgres://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgres://morya_user:YourSecurePassword123@localhost:5432/morya_fitness_db

# Or explicit PostgreSQL settings:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=morya_fitness_db
# DB_USER=morya_user
# DB_PASSWORD=YourSecurePassword123
# DB_HOST=localhost
# DB_PORT=5432

# ==============================================================================
# OPTION 2: Real MySQL Database (For cPanel / MySQL VPS)
# ==============================================================================
# Standard URL format: mysql://<user>:<password>@<host>:<port>/<database_name>
# DATABASE_URL=mysql://morya_user:YourSecurePassword123@localhost:3306/morya_fitness_db

# Or explicit MySQL settings:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=morya_fitness_db
# DB_USER=morya_user
# DB_PASSWORD=YourSecurePassword123
# DB_HOST=localhost
# DB_PORT=3306

# ==============================================================================
# CORS & Security
# ==============================================================================
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
